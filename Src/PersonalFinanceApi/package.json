{
  "name": "personal-finance-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal finance REST and MCP API: import, accounts, analysis and forecasts on S3",
  "main": "src/index.js",
  "scripts": {
    "dev": "PERSONALFINANCE_LOCAL_DATA_DIR=../../data PERSONALFINANCE_LOCAL_AUTH=true node src/index.js --api --port 4200",
    "dev:watch": "PERSONALFINANCE_LOCAL_DATA_DIR=../../data PERSONALFINANCE_LOCAL_AUTH=true node --watch src/index.js --api --port 4200",
    "start": "node src/index.js --api",
    "import": "node scripts/cli.mjs import",
    "analyse": "node scripts/cli.mjs analyse",
    "forecast": "node scripts/cli.mjs forecast",
    "sync:pull": "node scripts/sync.mjs pull",
    "sync:push": "node scripts/sync.mjs push",
    "build": "node scripts/build.mjs",
    "test": "node --test test/unit/*.test.js test/integration/*.test.js",
    "lint": "node scripts/lint.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.750.0",
    "@aws-sdk/client-lambda": "^3.750.0",
    "@aws-sdk/client-s3": "^3.750.0",
    "@aws-sdk/lib-dynamodb": "^3.750.0",
    "@codegenie/serverless-express": "^4.16.0",
    "aws-jwt-verify": "^5.1.0",
    "express": "^4.21.2"
  }
}
